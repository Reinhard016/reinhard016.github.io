---
import "../styles/global.css";
import Background from "../components/Background.astro";

const { title = "Home", description = "个人主页" } = Astro.props;
const base = import.meta.env.BASE_URL; // 支持子路径部署
---
<!doctype html>
<html lang="zh">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <Background />
    <nav class="top">
      <a class="brand" href={base}>ZZK</a>
      <a href={base}>Home</a>
      <a href={`${base}#papers`}>Papers</a>
      <a href={`${base}notes`}>Notes</a>
    </nav>
    <main>
      <slot />
    </main>
    <footer>
      <div class="wrap">
        © {new Date().getFullYear()} · Built with Astro · Hosted on GitHub Pages
      </div>
    </footer>
  </body>
</html>