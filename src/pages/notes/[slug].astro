---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const notes = await getCollection("notes");
  return notes.map((note) => ({
    params: { slug: note.slug },
    props: { note },
  }));
}

const { note } = Astro.props;
const { Content } = await note.render();
const base = import.meta.env.BASE_URL;
const fmt = (d) =>
  d.toLocaleDateString("zh-CN", { year: "numeric", month: "long", day: "numeric" });
---
<Layout title={`${note.data.title} · ZZK`} description={note.data.summary ?? ""}>
  <div class="wrap">
    <article class="prose">
      <a class="back" href={`${base}notes`}>← 返回 Notes</a>
      <h1>{note.data.title}</h1>
      <p class="meta" style="color:var(--fg-dim)">{fmt(note.data.date)}</p>
      <div style="margin-bottom:20px">
        {note.data.tags?.map((t) => <span class="tag">{t}</span>)}
      </div>
      <Content />
    </article>
  </div>
</Layout>