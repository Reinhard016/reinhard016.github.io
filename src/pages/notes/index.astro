---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const base = import.meta.env.BASE_URL;
const notes = (await getCollection("notes", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const fmt = (d) =>
  d.toLocaleDateString("zh-CN", { year: "numeric", month: "long", day: "numeric" });
---
<Layout title="Notes · ZZK" description="随手写的笔记">
  <div class="wrap">
    <section class="block">
      <h2>Notes</h2>
      <p class="sub">读论文的笔记、想法、踩过的坑</p>
      <div class="grid cols-2">
        {notes.map((n) => (
          <a class="card" href={`${base}notes/${n.slug}`}>
            <div class="meta">{fmt(n.data.date)}</div>
            <h3>{n.data.title}</h3>
            {n.data.summary && <p>{n.data.summary}</p>}
            <div style="margin-top:10px">
              {n.data.tags?.map((t) => <span class="tag">{t}</span>)}
            </div>
          </a>
        ))}
      </div>
    </section>
  </div>
</Layout>
